{
    "name": "vqt6 Hello World",
    "version": "0.1.0",
    "description": "vqt6 第一个示例 - 创建一个 Qt6 窗口，点击按钮退出",
    "source_dir": "./App",
    "build_dir": "./.tpv_build",
    "compiler": {
        "cmd": "llc",
        "flags": ["-filetype=obj", "-relocation-model=pic"]
    },
    "linker": {
        "cmd": "D:/msys64/mingw64/bin/clang++.exe",
        "flags": [
            "-fuse-ld=lld",
            "-lmsvcrt",
            "-lucrt",
            "-lpthread",
            "-lmingwex",
            "-lkernel32",
            "-lws2_32",
            "-ldnsapi",
            "-liphlpapi",
            "-L", "D:/Qt/6.11.2/mingw_64/lib",
            "-lQt6Core",
            "-lQt6Gui",
            "-lQt6Widgets",
            "-lQt6Network",
            "-lQt6Charts"
        ],
        "static_libs": [
            "../../includes/vqt6/build/lib/libvqt6_bridge.a"
        ],
        "output": "app.exe"
    },
    "includes": [
        "../../includes"
    ],
    "target": {
        "triple": "x86_64-pc-windows-gnu",
        "datalayout": "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
    },
    "options": {
        "slice_level": 3,
        "sha1_slice_level": 1,
        "target": "llvm",
        "strict_mode": true
    },
    "runtime": {
        "qt6_path": "D:/Qt/6.11.2/mingw_64",
        "qt6_dlls": ["Qt6Core.dll", "Qt6Gui.dll", "Qt6Widgets.dll", "Qt6Network.dll", "Qt6Charts.dll", "Qt6OpenGL.dll", "Qt6OpenGLWidgets.dll"],
        "qt6_plugins": ["platforms/qwindows.dll"]
    }
}
