{
    "name": "ViperCPW - CreateProcessA standalone repro",
    "version": "1.0.0",
    "description": "Standalone Viper repro for CreateProcessA returning 0 / GetLastError=87",
    "source_dir": "./App",
    "build_dir": "./__vpcbuild__",
    "compiler": {
        "cmd": "llc",
        "flags": [
            "-filetype=obj",
            "-relocation-model=pic"
        ]
    },
    "linker": {
        "cmd": "clang++.exe",
        "flags": [
            "-fuse-ld=lld",
            "-lmsvcrt",
            "-lucrt",
            "-lpthread",
            "-lmingwex",
            "-lkernel32"
        ],
        "output": "app.exe"
    },
    "includes": [
        "../../includes"
    ],
    "target": {
        "triple": "x86_64-pc-windows-gnu",
        "datalayout": "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
    },
    "options": {
        "slice_level": 3,
        "target": "llvm",
        "strict_mode": true
    }
}
