        _g_ui.on_anim_tick()


def WorkerTrain(arg: t.CPtr) -> t.CPtr:
    """后台训练线程入口"""
    if _g_ui is not None:
        _g_ui.worker_train()
    return None


# ============================================================
# 入口
# ============================================================
def run(pool: memhub.MemBuddy*) -> int:
    """创建面板单例并进入 Qt 事件循环"""
    global _g_ui
    _g_ui = AppGui(pool)
    return _g_ui.exec()
