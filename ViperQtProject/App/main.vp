    tree.expandAll()
    tree.itemChanged(OnCompToggled, 0)

    summary = vqt6.QLabel("已选择 3 个组件")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(summary._ptr, "font-size: 13px; color: #9cdcfe;")
    p2.addWidget(summary._ptr)
