finish_summary_ptr: t.CPtr = None
timer_ptr: t.CPtr = None
tree_ptr: t.CPtr = None
license_box_ptr: t.CPtr = None
eula_name_ptr: t.CPtr = None
agree_cb_ptr: t.CPtr = None
license_next_ptr: t.CPtr = None
channel_ptr: t.CPtr = None
install_btn_ptr: t.CPtr = None
opt0_ptr: t.CPtr = None
opt1_ptr: t.CPtr = None
opt2_ptr: t.CPtr = None
theme_sel_ptr: t.CPtr = None
central_ptr: t.CPtr = None
big_ptr: t.CPtr = None
sub_ptr: t.CPtr = None
desc_ptr: t.CPtr = None
lh_ptr: t.CPtr = None
h2_ptr: t.CPtr = None
h2b_ptr: t.CPtr = None
h3_ptr: t.CPtr = None
s3_ptr: t.CPtr = None
h4_ptr: t.CPtr = None
ok_ptr: t.CPtr = None
fsum_ptr: t.CPtr = None
oh_ptr: t.CPtr = None

# 全局状态
cur_step: int = 0
progress_val: int = 0
comp_count: int = 0
install_path: str = "C:/Program Files/Viper6"
channel_name: str = "稳定版（Stable）"
eula_idx: int = 0
eula_agreed: int = 0
cur_theme: int = 0


