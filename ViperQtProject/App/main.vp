    p2.addWidget(h2._ptr)

    h2b = vqt6.QLabel("展开分类并勾选需要的组件，实时统计安装体积与磁盘占用。")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(h2b._ptr, "font-size: 13px; color: #9a9a9a;")
    p2.addWidget(h2b._ptr)

    tree = vqt6.QTreeWidget()
    tree.setHeaderHidden(1)
    p2.addWidget(tree._ptr)
    tree_ptr = t.CPtr(tree._ptr)

    # 叶子磁盘占用经 setSize 存入节点 UserRole，统计时自动读取
    g0 = vqt6.QTreeWidgetItem("开发工具链")
    leaf = vqt6.QTreeWidgetItem("Viper 核心编译器与运行时（编译器 + 标准库运行时）[850 MB]")
    leaf.setCheckable(1)
    leaf.setChecked(1)
    leaf.setSize(850)
    g0.addChild(leaf)
    leaf = vqt6.QTreeWidgetItem("Viper 标准库与 includes 包 [350 MB]")
    leaf.setCheckable(1)
    leaf.setChecked(1)
    leaf.setSize(350)
    g0.addChild(leaf)
    tree.addTopLevelItem(g0)

    g1 = vqt6.QTreeWidgetItem("GUI 与网络开发")
    leaf = vqt6.QTreeWidgetItem("Qt6 桌面开发框架（GUI + vqt6 桥接库）[1200 MB]")
    leaf.setCheckable(1)
    leaf.setChecked(1)
    leaf.setSize(1200)
    g1.addChild(leaf)
    leaf = vqt6.QTreeWidgetItem("网络与调试工具（QtNetwork + VPC）[220 MB]")
    leaf.setCheckable(1)
    leaf.setChecked(0)
    leaf.setSize(220)
    g1.addChild(leaf)
    tree.addTopLevelItem(g1)

    g2 = vqt6.QTreeWidgetItem("附加内容")
    leaf = vqt6.QTreeWidgetItem("示例项目与开发文档 [90 MB]")
    leaf.setCheckable(1)
    leaf.setChecked(0)
    leaf.setSize(90)
    g2.addChild(leaf)
