    opt0 = vqt6.QCheckBox("创建开始菜单快捷方式")
    opt0.setChecked(1)
    p3.addWidget(opt0._ptr)
    opt0_ptr = t.CPtr(opt0._ptr)

    opt1 = vqt6.QCheckBox("将 viper 命令添加到系统 PATH")
    opt1.setChecked(0)
    p3.addWidget(opt1._ptr)
    opt1_ptr = t.CPtr(opt1._ptr)

    opt2 = vqt6.QCheckBox("创建桌面图标")
    opt2.setChecked(0)
    p3.addWidget(opt2._ptr)
    opt2_ptr = t.CPtr(opt2._ptr)

    # 安装位置行
    path_row = vqt6.QHBoxLayout()
    p3.addLayout(path_row._ptr)
    path_lb = vqt6.QLabel("安装位置:")
    path_row.addWidget(path_lb._ptr)
    path_lb2 = vqt6.QLabel(install_path)
    vqt6.vqt6_qwidget_set_stylesheet_utf8(path_lb2._ptr, "background-color: #252526; border: 1px solid #555555; border-radius: 4px; padding: 5px 8px; color: #ffffff;")
    path_row.addWidget(path_lb2._ptr)
    path_label_ptr = t.CPtr(path_lb2._ptr)
    browse_btn = vqt6.QPushButton("浏览...")
    path_row.addWidget(browse_btn._ptr)
    browse_btn.clicked(OnBrowse, 0)

    p3.addStretch(1)

    btn_row3 = vqt6.QHBoxLayout()
    p3.addLayout(btn_row3._ptr)
    btn_row3.addStretch(1)
    back3_btn = vqt6.QPushButton("< 上一步")
    btn_row3.addWidget(back3_btn._ptr)
    back3_btn.clicked(OnOptionsBack, 0)
    install_btn = vqt6.QPushButton("安装")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(install_btn._ptr, "background-color: #2a6da8; border: 1px solid #2a6da8; border-radius: 4px; padding: 8px 22px; color: #ffffff; font-size: 14px; font-weight: bold;")
    btn_row3.addWidget(install_btn._ptr)
    install_btn_ptr = t.CPtr(install_btn._ptr)
    install_btn.clicked(OnInstall, 0)

    stack.addWidget(page3._ptr)

    # ---------- 页4：安装进度 ----------
    page4 = vqt6.QWidget()
    p4 = vqt6.QVBoxLayout(page4)
    p4.setContentsMargins(36, 36, 36, 24)
    p4.setSpacing(12)

    h4 = vqt6.QLabel("正在安装 Viper 6.0...")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(h4._ptr, "font-size: 22px; color: #ffffff; font-weight: bold;")
    p4.addWidget(h4._ptr)

    prog = vqt6.QProgressBar()
    prog.setRange(0, 100)
    prog.setValue(0)
    p4.addWidget(prog._ptr)
    progress_ptr = t.CPtr(prog._ptr)

    pstat = vqt6.QLabel("正在准备安装环境...")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(pstat._ptr, "font-size: 13px; color: #9a9a9a;")
    p4.addWidget(pstat._ptr)
    progress_status_ptr = t.CPtr(pstat._ptr)

    log = vqt6.QPlainTextEdit()
    log.setReadOnly(1)
    p4.addWidget(log._ptr)
    log_ptr = t.CPtr(log._ptr)

    stack.addWidget(page4._ptr)

    # ---------- 页5：完成 ----------
    page5 = vqt6.QWidget()
    p5 = vqt6.QVBoxLayout(page5)
    p5.setContentsMargins(36, 40, 36, 24)
    p5.setSpacing(14)

    ok = vqt6.QLabel("安装完成")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(ok._ptr, "font-size: 30px; color: #4ec9b0; font-weight: bold;")
    p5.addWidget(ok._ptr)

    fsum = vqt6.QLabel("")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(fsum._ptr, "font-size: 14px; color: #d4d4d4;")
    p5.addWidget(fsum._ptr)
    finish_summary_ptr = t.CPtr(fsum._ptr)

    p5.addStretch(1)
    finish_btn = vqt6.QPushButton("完成")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(finish_btn._ptr, "background-color: #2a6da8; border-radius: 4px; padding: 8px 22px; color: #ffffff; font-size: 14px; font-weight: bold;")
    p5.addWidget(finish_btn._ptr)
    finish_btn.clicked(OnFinish, 0)

    stack.addWidget(page5._ptr)

    # ===== 定时器（模拟安装进度） =====
    timer = vqt6.QTimer()
    timer.timeout(OnProgressTick, 0)
    timer_ptr = t.CPtr(timer._ptr)

    # 初始化组件统计
    SetTextPtrs(big._ptr, sub._ptr, desc._ptr, lh._ptr, h2._ptr, h2b._ptr, h3._ptr, s3._ptr, h4._ptr, ok._ptr, fsum._ptr, oh._ptr)
    UpdateCompInfo()

    GotoStep(0)
    win.show()
    return app.exec()
