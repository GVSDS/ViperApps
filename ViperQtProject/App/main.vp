# EULA 文档名（显示序号用）
doc_name0: str = "Viper 6.0 最终用户许可协议"
doc_name1: str = "第三方开源组件许可声明"
doc_name2: str = "隐私政策"
doc_name3: str = "商标与版权声明"

# 发布渠道文本
channel_stable: str = "稳定版（Stable）"
channel_preview: str = "预览版（Preview）"
channel_dev: str = "开发版（Developer）"
str_yes: str = "是"
str_no: str = "否"


# ============================================================
# 工具：切换步骤 + 导航高亮
# ============================================================
def SetNavStyle(ptr: t.CPtr, qss: str):
    vqt6.vqt6_qwidget_set_stylesheet_utf8(ptr, qss)


def GotoStep(step: int):
    global cur_step
    cur_step = step
    vqt6.vqt6_qstackedwidget_set_current_index(stack_ptr, step)
    # 导航高亮（按当前主题）
    SetNavStyle(nav0_ptr, NavActiveCss() if step == 0 else NavIdleCss())
    SetNavStyle(nav1_ptr, NavActiveCss() if step == 1 else NavIdleCss())
    SetNavStyle(nav2_ptr, NavActiveCss() if step == 2 else NavIdleCss())
    SetNavStyle(nav3_ptr, NavActiveCss() if step == 3 else NavIdleCss())
    SetNavStyle(nav4_ptr, NavActiveCss() if step == 4 else NavIdleCss())
    SetNavStyle(nav5_ptr, NavActiveCss() if step == 5 else NavIdleCss())


# ============================================================
# 步骤0：欢迎页
# ============================================================
def OnNext(slot_id: int, data: t.CPtr):
    EnterEulaPage()
    GotoStep(1)


# ============================================================
# 步骤1：许可协议（逐份查看 + 逐份同意）
# ============================================================
def ShowEulaDoc(idx: int):
    """显示第 idx 份协议，并回填该协议的已同意状态"""
    txt: str = license_text
    name: str = doc_name0
    if idx == 1:
        txt = oss_text
        name = doc_name1
    elif idx == 2:
        txt = privacy_text
        name = doc_name2
    elif idx == 3:
        txt = credits_text
        name = doc_name3
    # 标题（x/4 · 协议名）
    buf: bytes = stdlib.malloc(128)
    viperlib.snprintf(buf, 128, "%d/4 · %s", idx + 1, name)
    vqt6.vqt6_qlabel_set_text_utf8(eula_name_ptr, buf)
    stdlib.free(buf)
    # 正文
    vqt6.vqt6_qplaintextedit_set_plain_text_utf8(license_box_ptr, txt)
    # 回填该协议已同意状态
    agreed: int = (eula_agreed >> idx) & 1
    vqt6.vqt6_qcheckbox_set_checked(agree_cb_ptr, agreed)
    vqt6.vqt6_qwidget_set_enabled(license_next_ptr, agreed)


def EnterEulaPage():
    """进入许可页：全部已同意则停在末份，否则续接当前进度"""
    global eula_idx
    if eula_agreed == 15:
        ShowEulaDoc(3)
    else:
        ShowEulaDoc(eula_idx)


def OnLicenseToggled(slot_id: int, data: t.CPtr):
    """勾选当前协议后才允许下一步"""
    checked: int = vqt6.vqt6_qcheckbox_is_checked(agree_cb_ptr)
    vqt6.vqt6_qwidget_set_enabled(license_next_ptr, checked)


def OnLicenseNext(slot_id: int, data: t.CPtr):
    """逐份同意：点下一步才放下一份；末份同意后进入组件选择"""
    global eula_idx, eula_agreed
    idx: int = eula_idx
    if idx < 0 or idx > 3:
        GotoStep(2)
        return
    if vqt6.vqt6_qcheckbox_is_checked(agree_cb_ptr) != 0:
        eula_agreed = eula_agreed | (1 << idx)
    if idx >= 3:
        GotoStep(2)
    else:
        eula_idx = idx + 1
        ShowEulaDoc(eula_idx)


def OnLicenseBack(slot_id: int, data: t.CPtr):
    GotoStep(0)


# ============================================================
# 步骤2：组件选择（树状图）
# ============================================================
def OnBack(slot_id: int, data: t.CPtr):
    EnterEulaPage()
    GotoStep(1)


def OnCompNext(slot_id: int, data: t.CPtr):
    GotoStep(3)


def UpdateCompInfo():
    """统计树勾选组件数与磁盘占用（跨模块用返回 int 的 vqt6 助手）"""
    global comp_count
    n: int = vqt6.qtree_checked_count(tree_ptr)
    mb: int = vqt6.qtree_checked_size(tree_ptr)
    comp_count = n
    buf1: bytes = stdlib.malloc(96)
    viperlib.snprintf(buf1, 96, "已选择 %d 个组件", n)
    vqt6.vqt6_qlabel_set_text_utf8(summary_ptr, buf1)
    stdlib.free(buf1)
    buf2: bytes = stdlib.malloc(96)
    viperlib.snprintf(buf2, 96, "所需磁盘空间: %d MB / 可用 51200 MB", mb)
    vqt6.vqt6_qlabel_set_text_utf8(disk_ptr, buf2)
    stdlib.free(buf2)


def OnCompToggled(slot_id: int, data: t.CPtr):
    """树节点勾选变化：重算组件数与磁盘占用"""
    UpdateCompInfo()


# ============================================================
# 步骤3：安装选项（独立页）
# ============================================================
def OnOptionsBack(slot_id: int, data: t.CPtr):
    GotoStep(2)


def OnBrowse(slot_id: int, data: t.CPtr):
    global install_path
    p: str = vqt6.QFileDialog.getExistingDirectory(None, "选择安装目录", "C:/")
    if p is not None and p != "":
        install_path = p
        vqt6.vqt6_qlabel_set_text_utf8(path_label_ptr, p)


def OnChannelChanged(slot_id: int, data: t.CPtr):
    """发布渠道切换"""
    global channel_name
    idx: int = vqt6.vqt6_qcombobox_current_index(channel_ptr)
    if idx == 1: channel_name = channel_preview
    elif idx == 2: channel_name = channel_dev
    else: channel_name = channel_stable


def OnInstall(slot_id: int, data: t.CPtr):
    """进入安装页并启动模拟进度"""
    global progress_val
    vqt6.vqt6_qwidget_set_enabled(install_btn_ptr, 0)
    GotoStep(4)
    progress_val = 0
    vqt6.vqt6_qprogressbar_set_value(progress_ptr, 0)
    vqt6.vqt6_qlabel_set_text_utf8(progress_status_ptr, "正在准备安装环境...")
    vqt6.vqt6_qplaintextedit_append_utf8(log_ptr, "== 开始安装 Viper 6.0 ==\n")
    vqt6.vqt6_qtimer_start(timer_ptr, 80)


# ============================================================
# 步骤4：安装进度（QTimer 模拟）
# ============================================================
def OnProgressTick(slot_id: int, data: t.CPtr):
    global progress_val
    progress_val += 4
    vqt6.vqt6_qprogressbar_set_value(progress_ptr, progress_val)
    if progress_val == 4:
        vqt6.vqt6_qplaintextedit_append_utf8(log_ptr, "[1/4] 正在准备安装环境...\n")
    elif progress_val == 28:
        vqt6.vqt6_qlabel_set_text_utf8(progress_status_ptr, "正在复制核心文件...")
        vqt6.vqt6_qplaintextedit_append_utf8(log_ptr, "[2/4] 正在复制核心文件...\n")
    elif progress_val == 52:
        vqt6.vqt6_qlabel_set_text_utf8(progress_status_ptr, "正在配置 Qt6 组件...")
        vqt6.vqt6_qplaintextedit_append_utf8(log_ptr, "[3/4] 正在配置 Qt6 组件...\n")
    elif progress_val == 76:
        vqt6.vqt6_qlabel_set_text_utf8(progress_status_ptr, "正在注册系统组件...")
        vqt6.vqt6_qplaintextedit_append_utf8(log_ptr, "[4/4] 正在注册系统组件...\n")
    elif progress_val >= 100:
        vqt6.vqt6_qtimer_stop(timer_ptr)
        vqt6.vqt6_qplaintextedit_append_utf8(log_ptr, "安装完成！\n")
        # 完成页摘要（含安装选项 + 渠道）
        yn0: str = str_yes if vqt6.vqt6_qcheckbox_is_checked(opt0_ptr) != 0 else str_no
        yn1: str = str_yes if vqt6.vqt6_qcheckbox_is_checked(opt1_ptr) != 0 else str_no
        yn2: str = str_yes if vqt6.vqt6_qcheckbox_is_checked(opt2_ptr) != 0 else str_no
        buf: bytes = stdlib.malloc(512)
        viperlib.snprintf(buf, 512, "安装位置: %s\n发布渠道: %s\n已安装组件: %d 个\n快捷方式: %s / PATH: %s / 桌面图标: %s\n\nViper 6.0 已成功安装到您的系统。", install_path, channel_name, comp_count, yn0, yn1, yn2)
        vqt6.vqt6_qlabel_set_text_utf8(finish_summary_ptr, buf)
        stdlib.free(buf)
        GotoStep(5)


# ============================================================
# 步骤5：完成页
# ============================================================
def OnFinish(slot_id: int, data: t.CPtr):
    vqt6.vqt6_qapplication_quit(app_ptr)


# ============================================================
# 主题切换（右上角）
# ============================================================
def RestyleAll():
    """按当前主题重刷带内联样式的关键控件"""
    vqt6.vqt6_qwidget_set_stylesheet_utf8(big_ptr, CssHuge())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(sub_ptr, CssSub())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(desc_ptr, CssDim())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(lh_ptr, CssTitle())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(h2_ptr, CssTitle())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(h2b_ptr, CssDim())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(h3_ptr, CssTitle())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(s3_ptr, CssDim())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(h4_ptr, CssTitle())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(eula_name_ptr, CssAccent())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(summary_ptr, CssAccent())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(disk_ptr, CssAccent())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(oh_ptr, CssSection())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(ok_ptr, CssOk())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(fsum_ptr, CssBody())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(progress_status_ptr, CssDim())
    vqt6.vqt6_qwidget_set_stylesheet_utf8(path_label_ptr, CssPathBox())


def ApplyTheme(theme: int):
    """切换深/浅主题：先设应用调色板（原生控件配色），再换 QSS 并重刷内联样式"""
    global cur_theme
    cur_theme = theme
    vqt6.vqt6_qapplication_set_theme_palette(app_ptr, theme)
    if theme == 1:
        vqt6.vqt6_qwidget_set_stylesheet_utf8(central_ptr, light_qss)
    else:
        vqt6.vqt6_qwidget_set_stylesheet_utf8(central_ptr, dark_qss)
    RestyleAll()
    GotoStep(cur_step)


def SetTextPtrs(big: t.CPtr, sub: t.CPtr, desc: t.CPtr, lh: t.CPtr, h2: t.CPtr, h2b: t.CPtr, h3: t.CPtr, s3: t.CPtr, h4: t.CPtr, ok: t.CPtr, fsum: t.CPtr, oh: t.CPtr):
    """记录各页文本标签指针（供主题切换重刷内联样式）"""
    global big_ptr, sub_ptr, desc_ptr, lh_ptr
    global h2_ptr, h2b_ptr, h3_ptr, s3_ptr, h4_ptr, ok_ptr, fsum_ptr, oh_ptr
    big_ptr = big
    sub_ptr = sub
    desc_ptr = desc
    lh_ptr = lh
    h2_ptr = h2
    h2b_ptr = h2b
    h3_ptr = h3
    s3_ptr = s3
    h4_ptr = h4
    ok_ptr = ok
    fsum_ptr = fsum
    oh_ptr = oh


def OnThemeChanged(slot_id: int, data: t.CPtr):
    idx: int = vqt6.vqt6_qcombobox_current_index(theme_sel_ptr)
    ApplyTheme(idx)


def main() -> int:
    global app_ptr, stack_ptr
    global nav0_ptr, nav1_ptr, nav2_ptr, nav3_ptr, nav4_ptr, nav5_ptr
    global progress_ptr, progress_status_ptr, log_ptr, path_label_ptr
    global summary_ptr, disk_ptr, finish_summary_ptr, timer_ptr
    global tree_ptr, license_box_ptr, eula_name_ptr
    global agree_cb_ptr, license_next_ptr, install_btn_ptr
    global channel_ptr, opt0_ptr, opt1_ptr, opt2_ptr
    global theme_sel_ptr, central_ptr

    app = vqt6.QApplication(t.CPtr(0))
    app_ptr = t.CPtr(app._ptr)
    vqt6.vqt6_qapplication_set_theme_palette(app_ptr, 0)
    # 启用 item-view（组件树）勾选与复选框同一套自绘渲染
    vqt6.vqt6_enable_custom_item_checks(app_ptr)

    # 主窗口（更宽更高）
    win = vqt6.QMainWindow()
    win.setWindowTitle("Viper 6.0 Installer")
    win.resize(1180, 780)
    vqt6.vqt6_qwidget_set_minimum_size(win._ptr, 1080, 700)

    central = vqt6.QWidget()
    central.setStyleSheet(dark_qss)
    win.setCentralWidget(central._ptr)
    central_ptr = t.CPtr(central._ptr)

    vroot = vqt6.QVBoxLayout(central)
    vroot.setContentsMargins(0, 0, 0, 0)
    vroot.setSpacing(0)

    # ===== 右上角：主题切换 =====
    topbar = vqt6.QHBoxLayout()
    topbar.setContentsMargins(0, 6, 14, 2)
    topbar.setSpacing(8)
    vroot.addLayout(topbar._ptr)
    topbar.addStretch(1)
    theme_lb = vqt6.QLabel("主题:")
    topbar.addWidget(theme_lb._ptr)
    theme_sel = vqt6.QComboBox()
    theme_sel.addItem("深色")
    theme_sel.addItem("浅色")
    theme_sel.setCurrentIndex(0)
    topbar.addWidget(theme_sel._ptr)
    theme_sel_ptr = t.CPtr(theme_sel._ptr)
    theme_sel.currentIndexChanged(OnThemeChanged, 0)

    root = vqt6.QHBoxLayout()
    root.setContentsMargins(0, 0, 0, 0)
    vroot.addLayout(root._ptr)

    # ===== 左导航面板（宽度固定，高度随窗口拉伸） =====
    nav_panel = vqt6.QWidget()
    vqt6.vqt6_qwidget_set_minimum_size(nav_panel._ptr, 240, 0)
    vqt6.vqt6_qwidget_set_maximum_size(nav_panel._ptr, 240, 10000)
    nav_box = vqt6.QVBoxLayout(nav_panel)
    nav_box.setContentsMargins(10, 16, 10, 10)
    nav_box.setSpacing(6)

    title_lb = vqt6.QLabel("Viper 6.0")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(title_lb._ptr, "font-size: 20px; color: #4a86c8; font-weight: bold; padding: 6px 14px;")
    nav_box.addWidget(title_lb._ptr)

    nav0 = vqt6.QLabel("欢迎")
    nav0.setStyleSheet(nav_active_qss)
    nav_box.addWidget(nav0._ptr)
    nav0_ptr = t.CPtr(nav0._ptr)

    nav1 = vqt6.QLabel("许可协议")
    nav1.setStyleSheet(nav_idle_qss)
    nav_box.addWidget(nav1._ptr)
    nav1_ptr = t.CPtr(nav1._ptr)

    nav2 = vqt6.QLabel("选择组件")
    nav2.setStyleSheet(nav_idle_qss)
    nav_box.addWidget(nav2._ptr)
    nav2_ptr = t.CPtr(nav2._ptr)

    nav3 = vqt6.QLabel("安装选项")
    nav3.setStyleSheet(nav_idle_qss)
    nav_box.addWidget(nav3._ptr)
    nav3_ptr = t.CPtr(nav3._ptr)

    nav4 = vqt6.QLabel("安装进度")
    nav4.setStyleSheet(nav_idle_qss)
    nav_box.addWidget(nav4._ptr)
    nav4_ptr = t.CPtr(nav4._ptr)

    nav5 = vqt6.QLabel("完成")
    nav5.setStyleSheet(nav_idle_qss)
    nav_box.addWidget(nav5._ptr)
    nav5_ptr = t.CPtr(nav5._ptr)

    nav_box.addStretch(1)
    ver_lb = vqt6.QLabel("v6.0.1 · 2026")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(ver_lb._ptr, "color: #666666; padding: 6px 14px;")
    nav_box.addWidget(ver_lb._ptr)

    root.addWidget(nav_panel._ptr)

    # ===== 右侧步骤容器 =====
    stack = vqt6.QStackedWidget()
    root.addWidget(stack._ptr)
    stack_ptr = t.CPtr(stack._ptr)

    # ---------- 页0：欢迎 ----------
    page0 = vqt6.QWidget()
    p0 = vqt6.QVBoxLayout(page0)
    p0.setContentsMargins(36, 40, 36, 24)
    p0.setSpacing(12)

    big = vqt6.QLabel("Viper 6.0")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(big._ptr, "font-size: 34px; color: #ffffff; font-weight: bold;")
    p0.addWidget(big._ptr)

    sub = vqt6.QLabel("为 Viper 语言平台安装工具链、Qt6 运行时与开发组件")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(sub._ptr, "font-size: 16px; color: #9cdcfe;")
    p0.addWidget(sub._ptr)

    desc = vqt6.QLabel("本向导将引导您完成 Viper 6.0 的安装。您可以自定义要安装的组件、\n安装选项与发布渠道，安装过程由模拟进度与日志展示（演示界面，无真实安装行为）。")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(desc._ptr, "font-size: 13px; color: #9a9a9a;")
    p0.addWidget(desc._ptr)

    p0.addStretch(1)
    next_btn = vqt6.QPushButton("下一步 >")
    p0.addWidget(next_btn._ptr)
    next_btn.clicked(OnNext, 0)

    stack.addWidget(page0._ptr)

    # ---------- 页1：许可协议（逐份同意） ----------
    page1 = vqt6.QWidget()
    p1 = vqt6.QVBoxLayout(page1)
    p1.setContentsMargins(36, 32, 36, 24)
    p1.setSpacing(10)

    lh = vqt6.QLabel("许可协议")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(lh._ptr, "font-size: 22px; color: #ffffff; font-weight: bold;")
    p1.addWidget(lh._ptr)

    eula_name = vqt6.QLabel("1/4 · Viper 6.0 最终用户许可协议")
    vqt6.vqt6_qwidget_set_stylesheet_utf8(eula_name._ptr, "font-size: 13px; color: #9cdcfe;")
