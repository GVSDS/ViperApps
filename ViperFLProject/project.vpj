{
    "name": "ViperFLProject - FLTK GUI Test",
    "version": "1.0.0",
    "source_dir": "./App",
    "build_dir": "./.tpv_build",
    "compiler": {
        "cmd": "llc",
        "flags": [
            "-filetype=obj",
            "-relocation-model=pic"
        ]
    },
    "linker": {
        "cmd": "clang++.exe",
        "flags": [
            "-fuse-ld=lld",
            "-lmsvcrt",
            "-lucrt",
            "-lpthread",
            "-lmingwex",
            "-lkernel32",
            "-lcomdlg32",
            "-lcomctl32",
            "-lole32",
            "-luuid",
            "-lwinmm",
            "-lgdi32",
            "-lgdiplus",
            "-ladvapi32",
            "-lshell32",
            "-lws2_32",
            "-luser32",
            "-lwinspool"
        ],
        "static_libs": [
            "../../includes/fltk/cfltk/build/libcfltk2.a",
            "../../includes/fltk/cfltk/build/libfltk_theme.a",
            "../../includes/fltk/cfltk/build/fltk/lib/libfltk_images.a",
            "../../includes/fltk/cfltk/build/fltk/lib/libfltk.a",
            "../../includes/fltk/cfltk/build/fltk/lib/libfltk_png.a",
            "../../includes/fltk/cfltk/build/fltk/lib/libfltk_jpeg.a",
            "../../includes/fltk/cfltk/build/fltk/lib/libfltk_z.a"
        ],
        "output": "app.exe"
    },
    "includes": [
        "../../includes"
    ],
    "target": {
        "triple": "x86_64-pc-windows-gnu",
        "datalayout": "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-f80:128-n8:16:32:64-S128"
    },
    "options": {
        "slice_level": 3,
        "target": "llvm",
        "strict_mode": true
    }
}
